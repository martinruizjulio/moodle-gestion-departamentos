<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/gestion_actividades/db" VERSION="2026100509" COMMENT="Gestion_actividades install schema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
